[Unit]
Description=Deploy the HTTPS Node sample from the verified Agency web release
After=docker.service bapx-agency-web-deploy.service
Requires=docker.service
ConditionPathExists=/etc/bapx-agency/sample-owner-password

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/libexec/bapx-agency-app-sample-deploy
TimeoutStartSec=5min
